<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Describes ScreenPortals.app to macOS. The release workflow puts the
     program in Contents/MacOS next to this file. LSUIElement keeps the app
     out of the Dock: it lives in the menu bar. -->
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>ScreenPortals</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.screenportals</string>
    <key>CFBundleName</key>
    <string>Screen Portals</string>
    <key>CFBundleDisplayName</key>
    <string>Screen Portals</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.6</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
